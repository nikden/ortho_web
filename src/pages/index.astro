---
import "../styles/global.css";
import About from "../components/About.astro";
import AtWork from "../components/AtWork.astro";
import ContactsFaq from "../components/ContactsFaq.astro";
import ExperienceAchievements from "../components/ExperienceAchievements.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { contacts, doctor, site } from "../config";

const canonicalUrl = site.url;
const absoluteOgImage = new URL(site.ogImage, site.url).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["Physician", "MedicalBusiness"],
  name: doctor.fullName,
  medicalSpecialty: ["Orthodontics", "OralSurgery"],
  description: site.description,
  url: site.url,
  image: absoluteOgImage,
  telephone: contacts.phone,
  email: contacts.email,
  priceRange: "₽₽₽",
  address: {
    "@type": "PostalAddress",
    streetAddress: "ул. Усачева, 29, корп. 1",
    addressLocality: "Москва",
    addressCountry: "RU",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      opens: "09:00",
      closes: "20:00",
    },
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main>
      <About />
      <ExperienceAchievements />
      <AtWork />
      <ContactsFaq />
    </main>
    <Footer />
  </body>
</html>
