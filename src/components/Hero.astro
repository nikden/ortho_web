---
import { ArrowRight, CheckCircle2, MapPin, MessageCircle, Phone } from "@lucide/astro";
import { benefits, contacts, doctor } from "../config";

const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const heroImage = `${baseUrl}${doctor.heroImage.replace(/^\//, "")}`;
---

<section class="relative overflow-hidden bg-gradient-to-b from-cyan-50 via-white to-white">
  <div class="container-page grid gap-12 pb-16 pt-12 lg:min-h-[680px] lg:grid-cols-[1.02fr_0.98fr] lg:items-center lg:pb-20 lg:pt-16">
    <div>
      <p class="eyebrow">Хирургическая ортодонтия в Москве</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-semibold leading-tight tracking-normal text-clinic-ink sm:text-5xl lg:text-6xl">
        Исправление прикуса с точной диагностикой и бережным хирургическим сопровождением
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
        {doctor.fullName} помогает взрослым и подросткам пройти ортодонтическое лечение предсказуемо: от цифрового плана до стабильной улыбки.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="btn-primary" href={contacts.booking} target="_blank" rel="noopener noreferrer">
          Записаться на консультацию
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        <a class="btn-secondary" href={contacts.whatsapp} target="_blank" rel="noopener noreferrer">
          <MessageCircle class="size-4" aria-hidden="true" />
          Написать в WhatsApp
        </a>
      </div>
      <div class="mt-8 flex flex-wrap gap-4 text-sm text-slate-600">
        <a class="inline-flex items-center gap-2 hover:text-cyan-700" href={contacts.phoneHref}>
          <Phone class="size-4 text-teal-500" aria-hidden="true" />
          {contacts.phone}
        </a>
        <span class="inline-flex items-center gap-2">
          <MapPin class="size-4 text-teal-500" aria-hidden="true" />
          {doctor.address}
        </span>
      </div>
    </div>

    <div class="relative">
      <div class="absolute -right-8 -top-8 hidden size-56 rounded-full bg-teal-100 lg:block"></div>
      <div class="relative overflow-hidden rounded-lg bg-white shadow-soft">
        <img
          src={heroImage}
          width="1200"
          height="900"
          alt="Хирург-ортодонт проводит цифровую диагностику пациента"
          class="h-[430px] w-full object-cover sm:h-[540px]"
        />
        <div class="absolute inset-x-4 bottom-4 grid gap-3 rounded-lg bg-white/94 p-4 shadow-lg sm:grid-cols-3">
          <div>
            <span class="block text-2xl font-semibold text-cyan-800">{doctor.experience}</span>
            <span class="text-xs text-slate-600">клинической практики</span>
          </div>
          <div>
            <span class="block text-2xl font-semibold text-cyan-800">{doctor.operations}</span>
            <span class="text-xs text-slate-600">хирургических этапов</span>
          </div>
          <div>
            <span class="block text-2xl font-semibold text-cyan-800">{doctor.patients}</span>
            <span class="text-xs text-slate-600">пациентов на лечении</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container-page -mt-8 pb-10">
    <div class="grid gap-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm md:grid-cols-3">
      {benefits.map((benefit) => (
        <article class="flex gap-3 rounded-md p-3">
          <CheckCircle2 class="mt-1 size-5 shrink-0 text-teal-500" aria-hidden="true" />
          <div>
            <h2 class="text-base font-semibold text-clinic-ink">{benefit.title}</h2>
            <p class="mt-1 text-sm leading-6 text-slate-600">{benefit.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
