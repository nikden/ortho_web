---
import { Clock3 } from "@lucide/astro";
import { cases } from "../config";

const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveImage = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<section id="cases" class="section-padding bg-white" aria-labelledby="cases-title">
  <div class="container-page">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow">Кейсы</p>
        <h2 id="cases-title" class="section-title">Примеры клинических задач</h2>
      </div>
      <p class="max-w-2xl text-sm leading-7 text-slate-600">
        Фотографии заменены нейтральными визуальными материалами. Реальные клинические снимки публикуются только с письменного согласия пациента.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {cases.map((item) => (
        <article class="card overflow-hidden">
          <div class="relative h-64 overflow-hidden bg-slate-100">
            <img
              src={resolveImage(item.image)}
              width="900"
              height="650"
              loading="lazy"
              alt={`Иллюстрация клинического кейса: ${item.title}`}
              class="h-full w-full object-cover transition duration-500 hover:scale-105"
            />
            <div class="absolute inset-x-4 top-4 flex justify-between text-xs font-semibold uppercase tracking-[0.12em] text-white">
              <span class="rounded bg-cyan-800/90 px-3 py-1">До</span>
              <span class="rounded bg-teal-500/90 px-3 py-1">После</span>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold text-clinic-ink">{item.title}</h3>
            <p class="mt-3 flex items-center gap-2 text-sm font-medium text-cyan-800">
              <Clock3 class="size-4" aria-hidden="true" />
              {item.duration}
            </p>
            <p class="mt-4 text-sm leading-7 text-slate-600">{item.result}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
