---
import { Menu, Phone } from "@lucide/astro";
import { contacts, doctor, navItems } from "../config";
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="container-page flex min-h-[var(--header-height)] items-center justify-between gap-4">
    <a href="#" class="flex items-center gap-3" aria-label="На главную">
      <span class="flex size-11 items-center justify-center rounded-lg bg-cyan-700 text-base font-bold text-white">СА</span>
      <span class="leading-tight">
        <span class="block text-sm font-semibold text-clinic-ink sm:text-base">{doctor.shortName}</span>
        <span class="block text-xs text-slate-500">{doctor.role}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Основная навигация">
      {navItems.map((item) => (
        <a class="text-sm font-medium text-slate-600 transition hover:text-cyan-700" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a class="btn-secondary" href={contacts.phoneHref}>
        <Phone class="size-4" aria-hidden="true" />
        {contacts.phone}
      </a>
    </div>

    <details class="group relative lg:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 text-cyan-800">
        <Menu class="size-5" aria-hidden="true" />
        <span class="sr-only">Открыть меню</span>
      </summary>
      <div class="absolute right-0 mt-3 w-72 rounded-lg border border-slate-200 bg-white p-4 shadow-soft">
        <nav class="grid gap-2" aria-label="Мобильная навигация">
          {navItems.map((item) => (
            <a class="rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-cyan-50 hover:text-cyan-800" href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </details>
  </div>
</header>
