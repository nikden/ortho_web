---
import { Mail, MessageCircle, Phone, Send } from "@lucide/astro";
import { business, contactItems } from "../config";

const contactIcons = {
  phone: Phone,
  telegram: Send,
  message: MessageCircle,
  mail: Mail,
};
---

<section id="contacts" class="section-padding bg-clinic-soft" aria-labelledby="contacts-title">
  <div class="container-page">
    <p class="eyebrow">Контакты</p>
    <h2 id="contacts-title" class="section-title">Связаться с доктором</h2>

    <div class="mt-5 rounded-lg border border-slate-200 bg-clinic-soft p-5 text-sm leading-6 text-slate-700">
      <p><strong>{business.name}</strong></p>
      <p>{business.address.postalCode}, {business.address.addressLocality}, {business.address.streetAddress}</p>
      <p>{business.openingHours}. Запись на прием предварительная.</p>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {contactItems.map((item) => {
        const Icon = contactIcons[item.icon];

        return (
          <a
            class="flex items-center gap-3 rounded-lg border border-slate-200 p-3 transition hover:border-cyan-300 hover:bg-cyan-50"
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            <Icon class="size-5 shrink-0 text-teal-500" aria-hidden="true" />
            <span class="min-w-0">
              <span class="block text-xs text-slate-500">{item.label}</span>
              <span class:list={["block text-sm font-semibold text-clinic-ink", item.breakWords && "break-words"]}>{item.value}</span>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>
