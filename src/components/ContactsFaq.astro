---
import { Mail, MessageCircle, Phone, Send } from "@lucide/astro";
import { contacts } from "../config";
---

<section id="contacts" class="section-padding bg-clinic-soft" aria-labelledby="contacts-title">
  <div class="container-page">
    <p class="eyebrow">Контакты</p>
    <h2 id="contacts-title" class="section-title">Связаться с доктором</h2>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <a class="flex min-h-28 flex-col justify-between rounded-lg border border-slate-200 p-5 transition hover:border-cyan-300 hover:bg-cyan-50" href={contacts.phoneHref}>
        <Phone class="size-6 text-teal-500" aria-hidden="true" />
        <span class="mt-6 text-sm text-slate-500">Мобильный</span>
        <span class="mt-1 font-semibold text-clinic-ink">{contacts.phone}</span>
      </a>
      <a class="flex min-h-28 flex-col justify-between rounded-lg border border-slate-200 p-5 transition hover:border-cyan-300 hover:bg-cyan-50" href={contacts.telegram} target="_blank" rel="noopener noreferrer">
        <Send class="size-6 text-teal-500" aria-hidden="true" />
        <span class="mt-6 text-sm text-slate-500">Telegram</span>
        <span class="mt-1 font-semibold text-clinic-ink">Написать</span>
      </a>
      <a class="flex min-h-28 flex-col justify-between rounded-lg border border-slate-200 p-5 transition hover:border-cyan-300 hover:bg-cyan-50" href={contacts.whatsapp} target="_blank" rel="noopener noreferrer">
        <MessageCircle class="size-6 text-teal-500" aria-hidden="true" />
        <span class="mt-6 text-sm text-slate-500">WhatsApp</span>
        <span class="mt-1 font-semibold text-clinic-ink">Написать</span>
      </a>
      <a class="flex min-h-28 flex-col justify-between rounded-lg border border-slate-200 p-5 transition hover:border-cyan-300 hover:bg-cyan-50" href={contacts.maxMessenger} target="_blank" rel="noopener noreferrer">
        <MessageCircle class="size-6 text-teal-500" aria-hidden="true" />
        <span class="mt-6 text-sm text-slate-500">MAX</span>
        <span class="mt-1 font-semibold text-clinic-ink">Написать</span>
      </a>
      <a class="flex min-h-28 flex-col justify-between rounded-lg border border-slate-200 p-5 transition hover:border-cyan-300 hover:bg-cyan-50" href={contacts.emailHref}>
        <Mail class="size-6 text-teal-500" aria-hidden="true" />
        <span class="mt-6 text-sm text-slate-500">Email</span>
        <span class="mt-1 break-words font-semibold text-clinic-ink">{contacts.email}</span>
      </a>
    </div>
  </div>
</section>
