---
import { Mail, MapPin, MessageCircle, Phone, Send } from "@lucide/astro";
import { contacts, doctor, faqItems } from "../config";
---

<section id="contacts" class="section-padding bg-white" aria-labelledby="contacts-title">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">Контакты и FAQ</p>
        <h2 id="contacts-title" class="section-title">Запишитесь удобным способом</h2>
        <p class="section-lead">
          Администратор уточнит жалобы, подберет ближайшее время и подскажет, какие снимки взять на первичный прием.
        </p>

        <div class="mt-8 grid gap-3">
          <a class="flex items-center gap-3 rounded-lg border border-slate-200 p-4 transition hover:border-cyan-300 hover:bg-cyan-50" href={contacts.phoneHref}>
            <Phone class="size-5 text-teal-500" aria-hidden="true" />
            <span class="font-semibold text-clinic-ink">{contacts.phone}</span>
          </a>
          <a class="flex items-center gap-3 rounded-lg border border-slate-200 p-4 transition hover:border-cyan-300 hover:bg-cyan-50" href={contacts.emailHref}>
            <Mail class="size-5 text-teal-500" aria-hidden="true" />
            <span class="font-semibold text-clinic-ink">{contacts.email}</span>
          </a>
          <a class="flex items-center gap-3 rounded-lg border border-slate-200 p-4 transition hover:border-cyan-300 hover:bg-cyan-50" href={contacts.telegram} target="_blank" rel="noopener noreferrer">
            <Send class="size-5 text-teal-500" aria-hidden="true" />
            <span class="font-semibold text-clinic-ink">Telegram</span>
          </a>
          <a class="flex items-center gap-3 rounded-lg border border-slate-200 p-4 transition hover:border-cyan-300 hover:bg-cyan-50" href={contacts.whatsapp} target="_blank" rel="noopener noreferrer">
            <MessageCircle class="size-5 text-teal-500" aria-hidden="true" />
            <span class="font-semibold text-clinic-ink">WhatsApp</span>
          </a>
        </div>

        <div class="mt-8 overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
          <div class="flex h-72 items-center justify-center bg-[linear-gradient(135deg,#e0f2fe_25%,#f8fafc_25%,#f8fafc_50%,#e0f2fe_50%,#e0f2fe_75%,#f8fafc_75%,#f8fafc_100%)] bg-[length:32px_32px] p-6 text-center">
            <div class="rounded-lg bg-white/95 p-5 shadow-sm">
              <MapPin class="mx-auto size-7 text-cyan-700" aria-hidden="true" />
              <p class="mt-3 font-semibold text-clinic-ink">{doctor.clinic}</p>
              <p class="mt-1 text-sm text-slate-600">{doctor.address}</p>
              <p class="mt-1 text-sm text-slate-600">{doctor.workHours}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid gap-6">
        <form class="rounded-lg bg-cyan-800 p-6 text-white shadow-soft" action="#" method="post">
          <h3 class="text-2xl font-semibold">Оставить запрос</h3>
          <p class="mt-2 text-sm leading-6 text-cyan-50">Форма является демонстрационной. Для реальной записи используйте телефон или мессенджеры.</p>
          <div class="mt-6 grid gap-4">
            <label class="grid gap-2 text-sm font-medium">
              Имя
              <input class="rounded-lg border border-white/20 bg-white px-4 py-3 text-clinic-ink outline-none focus:ring-4 focus:ring-teal-300" type="text" name="name" placeholder="Ваше имя" autocomplete="name" />
            </label>
            <label class="grid gap-2 text-sm font-medium">
              Телефон
              <input class="rounded-lg border border-white/20 bg-white px-4 py-3 text-clinic-ink outline-none focus:ring-4 focus:ring-teal-300" type="tel" name="phone" placeholder="+7" autocomplete="tel" />
            </label>
            <button class="inline-flex items-center justify-center gap-2 rounded-lg bg-teal-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-teal-600" type="submit">
              Отправить запрос
              <Send class="size-4" aria-hidden="true" />
            </button>
          </div>
          <p class="mt-4 text-xs leading-5 text-cyan-100">Нажимая кнопку, вы соглашаетесь с обработкой персональных данных.</p>
        </form>

        <div class="rounded-lg border border-slate-200 bg-white p-6">
          <h3 class="text-2xl font-semibold text-clinic-ink">Частые вопросы</h3>
          <div class="mt-5 divide-y divide-slate-200">
            {faqItems.map((item) => (
              <details class="group py-4">
                <summary class="cursor-pointer list-none text-base font-semibold text-clinic-ink">
                  {item.question}
                </summary>
                <p class="mt-3 text-sm leading-7 text-slate-600">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
