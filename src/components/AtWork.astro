---
import { atWork } from "../config";

const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resolveImage = (path: string) => `${baseUrl}${path.replace(/^\//, "")}`;
---

<section id="at-work" class="section-padding bg-clinic-soft" aria-labelledby="at-work-title">
  <div class="container-page">
    <h2 id="at-work-title" class="section-title mt-0">За работой</h2>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {atWork.map((item) => (
        <article class="card overflow-hidden">
          <div class="relative h-80 overflow-hidden bg-slate-100 sm:h-[480px]">
            <img
              src={resolveImage(item.image)}
              width="900"
              height="650"
              loading="lazy"
              alt={item.alt}
              class="h-full w-full object-cover transition duration-500 hover:scale-105"
            />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
