---
import { experienceAchievements } from "../config";
---

<section id="experience" class="section-padding bg-clinic-soft" aria-labelledby="experience-title">
  <div class="container-page">
    <details class="group rounded-lg border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6">
        <h2 id="experience-title" class="section-title mt-0">Опыт и достижения</h2>
        <span class="flex size-12 shrink-0 items-center justify-center rounded-lg border border-cyan-700/20 text-3xl font-light leading-none text-cyan-800 transition group-open:rotate-45" aria-hidden="true">
          &#43;
        </span>
      </summary>

      <ul class="mt-8 grid gap-4 text-base leading-8 text-slate-700">
        {experienceAchievements.map((item) => (
          <li class="flex gap-3">
            <span class="mt-3 size-2 shrink-0 rounded-full bg-teal-500" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </details>
  </div>
</section>
